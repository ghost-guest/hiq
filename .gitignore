
!/desktop/frontend/dist/.gitkeep
# Build artifacts
# Build/CI binary artifacts and tool dirs (not project source)
# CodeGraph per-project index (rebuilt locally; never committed)
# Editor / OS
# Environment / local config (hiq.example.toml is the shared template)
# Generated tool output and CUA replay traces (rebuilt at runtime, not source)
# Go test/build scratch
# Local test / benchmark outputs
# Local test / migration artifacts
# Node / frontend dependencies and caches
# Project-local hiq state (commands/ removed; skills/ is tracked).
# Scratch / experiment code (one-off debug scripts, never part of the build)
# Stray root-level test/debug artifacts (CUA notepad probes, demo outputs)
# Wails desktop artifacts
# Website (Astro) — not part of the CLI distribution; kept local only
# Windows reserved-name stray file (empty artifact, not project content)
*.coverprofile
*.local
*.out
*.test
.DS_Store
.codegraph/
.env
.env.local
**/.env
**/.env.local
.agents/
.idea/
.npm/
.pnpm-store/
.vscode/
.zcode/
/.claude/
/.momapeer.zip
# ~/.hiq-style project-local dir. The built-in ppt-auto skill now lives
# under internal/assets/pptauto (embedded into the binary); .hiq/ here is
# purely local runtime state (the released copy lands in the user's home), so
# it is fully ignored.
/.momapeer/
__pycache__/
*.pyc
/bin/
/cua-replay-trace/
/cua-test.txt
/desktop.exe
/desktop/.env
/desktop/build/bin/
/desktop/build/obj/
/desktop/desktop
/desktop/desktop.exe
/desktop/e2e-*.log
/desktop/*-e2e.exe
/desktop/frontend/dist/*
/desktop/frontend/package.json.md5
/desktop/frontend/wailsjs/
/desktop/keys/
/desktop/hiq.toml
/dist/
/hiq
/hiq.exe
/hiq.toml
/npm/.stage/
/output.pptx
/output/
/read-notepad.ps1
/scratch/
/site/
/stage/
/test_silent.wav
/tests/
/updateFile/
/verify_notepad.py
Thumbs.db
benchmarks/context-maintenance-e2e/run/
coverage.out
cpu.prof
cua-vlm-trace/
desktop/frontend/.vite/
jobs_latest.json
mem.prof
node_modules/
nul
runs_latest.json
.tmp_diff/

# Scratch Go files at repo root (test_*.go) — throwaway, never commit
/test_*.go
*.test.exe

# Test output artifacts (may contain sensitive data)
*_output*.json
*_output*.xml
*_struct.json
*.txt.template
%TEMP%/

# local build/sign artifacts (upgrade batch 08-21)
desktop/sign.exe
ndvshot.exe
desktop/frontend/dist-crash/
