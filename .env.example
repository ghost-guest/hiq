# Copy to .env and fill in. Only secrets belong here — a provider's base_url and
# model are configured in hiq.toml, where api_key_env points at these variables.
# No provider is required; configure at least one that you have a key for.

# ── Direct providers (uncomment the ones you have) ──────────────────────────
# QWEN_API_KEY=            # 通义千问 DashScope — dashscope.aliyuncs.com
# DEEPSEEK_API_KEY=        # DeepSeek — api.deepseek.com
# VOLCENGINE_API_KEY=      # 火山引擎 Doubao — ark.cn-beijing.volces.com
# ZHIPU_API_KEY=           # 智谱 GLM — open.bigmodel.cn
# MINIMAX_API_KEY=         # MiniMax — api.minimaxi.com
# MOONSHOT_API_KEY=        # Moonshot Kimi — api.moonshot.cn
# MIMO_API_KEY=            # 小米 MiMo — api.xiaomimimo.com
# STEPFUN_API_KEY=         # 阶跃星辰 — api.stepfun.com
# XFYUN_API_KEY=           # 讯飞 MaaS — spark-api-open.xf-yun.com
# ANTHROPIC_API_KEY=       # Anthropic Claude — api.anthropic.com
# OPENAI_API_KEY=          # OpenAI — api.openai.com

# ── Coding Plan aggregators (separate keys, subscription quota) ────────────
# QWEN_CODING_API_KEY=     # 通义 Coding — coding.dashscope.aliyuncs.com (sk-sp- prefix)
# ZHIPU_CODING_API_KEY=    # 智谱 z.ai — api.z.ai
# BAIDU_API_KEY=           # 百度千帆 Token Plan — qianfan.baidubce.com
# TENCENT_API_KEY=         # 腾讯云 TokenHub — api.lkeap.cloud.tencent.com
# (VOLCENGINE_API_KEY, STEPFUN_API_KEY, XFYUN_API_KEY are shared with the
#  direct provider above — same endpoint, subscription tier distinguishes them)

# ── Optional: Bot channels (QQ / 飞书 / 微信) ───────────────────────────────
# QQ_BOT_APP_SECRET=      # QQ Bot app secret
# FEISHU_BOT_APP_SECRET=  # 飞书 Bot app secret
# WEIXIN_BOT_TOKEN=       # 微信 Bot token

# ── Optional: Web search engines (fallback chain: Brave → Exa → Linkup → AnySearch) ──
# BRAVE_API_KEY=          # Brave Search — api.search.brave.com
# EXA_API_KEY=            # Exa — api.exa.ai
# LINKUP_API_KEY=         # Linkup — api.linkup.so
# ANYSEARCH_API_KEY=      # AnySearch — api.anysearch.com
